# ============================================================
# PROPERTY SEARCH APP - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to GitHub.
# ============================================================

# --- Firebase Config ---
# Get from: https://console.firebase.google.com -> Project Settings
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# --- Google Maps API ---
# Get from: https://console.cloud.google.com -> APIs & Services -> Credentials
# Enable these 4 APIs: Maps JavaScript API, Geocoding API, Places API, Distance Matrix API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# --- RentCast API ---
# Get from: https://rentcast.io/api
# Free tier: 50 calls/month
# IMPORTANT: Results are cached in Firestore - data is never pulled twice!
# This key is server-side only (no NEXT_PUBLIC_ prefix) for security.
RENTCAST_API_KEY=your_rentcast_api_key

# --- School Ratings ---
# GreatSchools has no free API tier.
# School names are fetched via Google Places (above).
# Ratings (E/M/H format like 8/7/9) are entered manually
# using the pencil/edit icon in the Buy page table.
# Visit greatschools.org or niche.com to look up ratings.
# No API key needed for school ratings.
